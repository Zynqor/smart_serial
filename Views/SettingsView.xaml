<UserControl x:Class="SerialProtocolAssistant.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1600">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：设置选项 -->
            <StackPanel Grid.Column="0">
                <!-- 音效设置 -->
                <ui:Card Margin="0,0,0,15" Padding="20">
                    <StackPanel>
                        <TextBlock Text="音效设置" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

                        <CheckBox Content="启用报警音效"
                                 IsChecked="{Binding AlarmSoundEnabled, Mode=TwoWay}"
                                 FontSize="13" Margin="0,0,0,15"/>

                        <ui:Button Content="测试音效" Command="{Binding TestAlarmSoundCommand}"
                                  Appearance="Secondary" Width="120" Height="36"
                                  HorizontalAlignment="Left"/>
                    </StackPanel>
                </ui:Card>

                <!-- 数据库设置 -->
                <ui:Card Margin="0,0,0,15" Padding="20">
                    <StackPanel>
                        <TextBlock Text="数据库设置" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="自动清理天数:" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBox Grid.Column="1" Text="{Binding AutoCleanupDays, Mode=TwoWay}"
                                    Height="32" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="天（超过此天数的历史数据将被清理）"
                                      VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" FontSize="12"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="优化数据库" Command="{Binding OptimizeDatabaseCommand}"
                                      Appearance="Secondary" Width="120" Height="36"/>
                            <ui:Button Content="清理旧数据" Command="{Binding CleanupOldDataCommand}"
                                      Appearance="Secondary" Width="120" Height="36" Margin="15,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- 保存设置 -->
                <ui:Card Padding="20">
                    <StackPanel>
                        <ui:Button Content="保存所有设置" Command="{Binding SaveSettingsCommand}"
                                  Appearance="Primary" Width="150" Height="40" FontSize="14"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Text="注意：部分设置需要重启应用程序后生效"
                                  FontSize="11" Foreground="Gray" Margin="0,10,0,0"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <!-- 右侧：统计信息和关于 -->
            <StackPanel Grid.Column="2">
                <!-- 数据库统计 -->
                <ui:Card Margin="0,0,0,15" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="数据库统计" FontSize="16" FontWeight="Bold"/>
                            <ui:Button Content="刷新" Command="{Binding RefreshStatisticsCommand}"
                                      Appearance="Secondary" Width="70" Height="30"
                                      HorizontalAlignment="Right"/>
                        </Grid>

                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                            <Grid>
                                <TextBlock Text="数据库大小" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DatabaseSizeMB, StringFormat={}{0:F2} MB}"
                                          FontSize="18" FontWeight="Bold" Foreground="#2196F3"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                            <Grid>
                                <TextBlock Text="历史数据记录" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalDataRecords, StringFormat={}{0:N0}}"
                                          FontSize="18" FontWeight="Bold" Foreground="#4CAF50"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                            <Grid>
                                <TextBlock Text="报警记录" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalAlarmRecords, StringFormat={}{0:N0}}"
                                          FontSize="18" FontWeight="Bold" Foreground="#FF9800"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="最早数据时间" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding OldestDataTime}" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="最新数据时间" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding NewestDataTime}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!-- 关于 -->
                <ui:Card Padding="20">
                    <StackPanel>
                        <TextBlock Text="关于" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

                        <StackPanel HorizontalAlignment="Center" Margin="0,10,0,20">
                            <TextBlock Text="RS-485多设备监控系统" FontSize="16" FontWeight="Bold"
                                      HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding AppVersion}" FontSize="14" Foreground="Gray"
                                      HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding BuildDate, StringFormat=构建日期: {0}}" FontSize="11" Foreground="Gray"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,1" Padding="0,15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="功能特性" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock Text="• 多设备RS-485通信" FontSize="11" Margin="0,3"/>
                                <TextBlock Text="• 实时数据监控与图表" FontSize="11" Margin="0,3"/>
                                <TextBlock Text="• 历史数据查询与导出" FontSize="11" Margin="0,3"/>
                                <TextBlock Text="• 智能报警管理" FontSize="11" Margin="0,3"/>
                                <TextBlock Text="• 灵活的协议配置" FontSize="11" Margin="0,3"/>
                                <TextBlock Text="• SQLite数据持久化" FontSize="11" Margin="0,3"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="© 2025 串口协议助手" FontSize="11" Foreground="Gray"
                                  HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
