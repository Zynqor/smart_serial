<UserControl x:Class="SerialProtocolAssistant.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1600">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 查询条件面板 -->
        <ui:Card Grid.Row="0" Margin="0,0,0,10" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 第一行：日期范围选择 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="开始日期:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding StartDate, Mode=TwoWay}"
                           VerticalAlignment="Center" Height="32"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="结束日期:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker Grid.Row="0" Grid.Column="4" SelectedDate="{Binding EndDate, Mode=TwoWay}"
                           VerticalAlignment="Center" Height="32"/>

                <TextBlock Grid.Row="0" Grid.Column="6" Text="设备:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Row="0" Grid.Column="7" ItemsSource="{Binding Devices}"
                         SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                         DisplayMemberPath="Name"
                         VerticalAlignment="Center" Height="32"/>

                <!-- 第二行：设备和通道选择 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="通道:" VerticalAlignment="Center" Margin="0,10,10,0"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Channels}"
                         SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                         DisplayMemberPath="Name"
                         VerticalAlignment="Center" Height="32" Margin="0,10,0,0"/>

                <TextBlock Grid.Row="1" Grid.Column="3" Text="每页记录数:" VerticalAlignment="Center" Margin="0,10,10,0"/>
                <ComboBox Grid.Row="1" Grid.Column="4" SelectedValue="{Binding PageSize, Mode=TwoWay}"
                         VerticalAlignment="Center" Height="32" Margin="0,10,0,0">
                    <ComboBoxItem Content="50" Tag="50"/>
                    <ComboBoxItem Content="100" Tag="100" IsSelected="True"/>
                    <ComboBoxItem Content="200" Tag="200"/>
                    <ComboBoxItem Content="500" Tag="500"/>
                    <ComboBoxItem Content="1000" Tag="1000"/>
                </ComboBox>

                <!-- 操作按钮 -->
                <StackPanel Grid.Row="1" Grid.Column="7" Orientation="Horizontal" Margin="0,10,0,0">
                    <ui:Button Content="查询" Command="{Binding QueryDataCommand}"
                              Appearance="Primary" Width="100" Height="32"
                              IsEnabled="{Binding IsQuerying, Converter={StaticResource InverseBooleanConverter}}"/>
                    <ui:Button Content="导出Excel" Command="{Binding ExportExcelCommand}"
                              Appearance="Secondary" Width="100" Height="32" Margin="10,0,0,0"/>
                    <ui:Button Content="导出CSV" Command="{Binding ExportCsvCommand}"
                              Appearance="Secondary" Width="100" Height="32" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- 数据表格 -->
            <ui:Card Grid.Column="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="查询结果" FontSize="14" FontWeight="Bold"
                              Margin="15,15,15,10"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding DataRecords}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             SelectionMode="Extended"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             AlternatingRowBackground="#F5F5F5"
                             Margin="10,0,10,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="设备ID" Binding="{Binding DeviceId}" Width="100"/>
                            <DataGridTextColumn Header="设备名称" Binding="{Binding DeviceName}" Width="120"/>
                            <DataGridTextColumn Header="通道ID" Binding="{Binding ChannelId}" Width="100"/>
                            <DataGridTextColumn Header="通道名称" Binding="{Binding ChannelName}" Width="120"/>
                            <DataGridTextColumn Header="数值" Binding="{Binding Value, StringFormat=F2}" Width="100"/>
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="80"/>
                            <DataGridTextColumn Header="记录时间" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:Card>

            <!-- 统计信息面板 -->
            <ui:Card Grid.Column="2" Padding="15">
                <StackPanel>
                    <TextBlock Text="统计信息" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                    <StackPanel Visibility="{Binding HasStatistics, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="总记录数" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding TotalRecords}" FontSize="20" FontWeight="Bold" Foreground="#2196F3" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="平均值" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding AverageValue, StringFormat=F2}" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="最大值" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding MaxValue, StringFormat=F2}" FontSize="20" FontWeight="Bold" Foreground="#FF5722" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Padding="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="最小值" FontSize="12" Foreground="Gray"/>
                                <TextBlock Text="{Binding MinValue, StringFormat=F2}" FontSize="20" FontWeight="Bold" Foreground="#9C27B0" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="暂无统计信息" FontSize="12" Foreground="Gray"
                              Visibility="{Binding HasStatistics, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                              VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50,0,0"/>
                </StackPanel>
            </ui:Card>
        </Grid>

        <!-- 分页控件 -->
        <ui:Card Grid.Row="2" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:Button Content="上一页" Command="{Binding PreviousPageCommand}"
                          Appearance="Secondary" Width="80" Height="32"/>
                <TextBlock VerticalAlignment="Center" Margin="20,0">
                    <Run Text="第"/>
                    <Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="页 / 共"/>
                    <Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="页"/>
                </TextBlock>
                <ui:Button Content="下一页" Command="{Binding NextPageCommand}"
                          Appearance="Secondary" Width="80" Height="32"/>
                <TextBlock Text="{Binding TotalRecords, StringFormat=总计 {0} 条记录}"
                          VerticalAlignment="Center" Margin="20,0,0,0" Foreground="Gray"/>
            </StackPanel>
        </ui:Card>
    </Grid>
</UserControl>
