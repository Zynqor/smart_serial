<UserControl x:Class="SerialProtocolAssistant.Views.DeviceConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1600">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 串口配置面板 -->
        <ui:Card Grid.Row="0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0" Text="串口配置" FontSize="16" FontWeight="Bold"/>

                <!-- 配置项 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="串口:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="35"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePorts}"
                                 SelectedItem="{Binding SelectedPort, Mode=TwoWay}"
                                 Height="32" VerticalAlignment="Center"/>
                        <ui:Button Grid.Column="2" Content="🔄" Command="{Binding RefreshPortsCommand}"
                                  Width="35" Height="32" ToolTip="刷新串口列表"/>
                    </Grid>

                    <TextBlock Grid.Column="3" Text="波特率:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="4" ItemsSource="{Binding BaudRates}"
                             SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay}"
                             Height="32" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="6" Text="数据位:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="7" ItemsSource="{Binding DataBits}"
                             SelectedItem="{Binding SelectedDataBits, Mode=TwoWay}"
                             Height="32" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="9" Text="停止位:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="10" ItemsSource="{Binding StopBits}"
                             SelectedItem="{Binding SelectedStopBits, Mode=TwoWay}"
                             Height="32" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="12" Text="校验位:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="13" ItemsSource="{Binding Parities}"
                             SelectedItem="{Binding SelectedParity, Mode=TwoWay}"
                             Height="32" VerticalAlignment="Center"/>
                </Grid>

                <!-- 操作按钮 -->
                <StackPanel Grid.Row="4" Orientation="Horizontal">
                    <ui:Button Content="打开串口" Command="{Binding OpenPortCommand}"
                              Appearance="Primary" Width="100" Height="36"
                              IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBooleanConverter}}"/>
                    <ui:Button Content="关闭串口" Command="{Binding ClosePortCommand}"
                              Appearance="Danger" Width="100" Height="36" Margin="15,0,0,0"
                              IsEnabled="{Binding IsConnected}"/>

                    <Border Width="2" Background="#E0E0E0" Margin="30,0"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Margin="0,0,10,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#BDBDBD"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="未连接"/>
                                    <Setter Property="Foreground" Value="#757575"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Text" Value="已连接"/>
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 设备列表和协议信息 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- 设备列表 -->
            <ui:Card Grid.Column="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#E8F5E9" Padding="15,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="设备列表" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <ui:Button Grid.Column="1" Content="刷新" Command="{Binding RefreshDevicesCommand}"
                                  Appearance="Secondary" Width="70" Height="30"/>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             SelectionMode="Single"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             AlternatingRowBackground="#F5F5F5"
                             Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="设备ID" Binding="{Binding Id}" Width="100"/>
                            <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="地址" Binding="{Binding Address, StringFormat=0x{0:X2}}" Width="80"/>
                            <DataGridCheckBoxColumn Header="已启用" Binding="{Binding Enabled}" Width="80"/>
                            <DataGridTextColumn Header="轮询间隔(ms)" Binding="{Binding PollingIntervalMs}" Width="120"/>
                            <DataGridTextColumn Header="通道数" Binding="{Binding Channels.Count}" Width="80"/>
                            <DataGridTextColumn Header="超时时间(ms)" Binding="{Binding TimeoutMs}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:Card>

            <!-- 协议信息 -->
            <ui:Card Grid.Column="2" Padding="20">
                <StackPanel>
                    <TextBlock Text="协议信息" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="当前协议" FontSize="11" Foreground="Gray" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ProtocolInfo}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="设备数量" FontSize="11" Foreground="Gray" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Devices.Count, StringFormat={}{0} 个设备}" FontSize="20" FontWeight="Bold" Foreground="#2196F3"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="说明" FontSize="11" Foreground="Gray" Margin="0,0,0,10"/>
                            <TextBlock Text="• 请先通过菜单栏加载协议配置文件" FontSize="11" TextWrapping="Wrap" Margin="0,5"/>
                            <TextBlock Text="• 配置串口参数后点击打开串口" FontSize="11" TextWrapping="Wrap" Margin="0,5"/>
                            <TextBlock Text="• 确保设备地址与实际硬件匹配" FontSize="11" TextWrapping="Wrap" Margin="0,5"/>
                            <TextBlock Text="• 在实时监控页面开始数据采集" FontSize="11" TextWrapping="Wrap" Margin="0,5"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
