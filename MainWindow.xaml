<Window x:Class="SerialProtocolAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SerialProtocolAssistant"
        xmlns:views="clr-namespace:SerialProtocolAssistant.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="RS-485多设备监控系统" Height="900" Width="1600"
        ResizeMode="CanResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 菜单栏 -->
        <Menu Grid.Row="0" Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
              Height="36" FontSize="13" VerticalAlignment="Stretch">
            <MenuItem Header="文件(_F)" Height="36" Padding="12,6">
                <MenuItem Header="加载协议配置..." Click="LoadProtocol_Click" Height="30" Padding="10,5"/>
                <MenuItem Header="保存协议配置..." Click="SaveProtocol_Click" Height="30" Padding="10,5"/>
                <Separator/>
                <MenuItem Header="导出当前数据..." Click="ExportCurrentData_Click" Height="30" Padding="10,5"/>
                <Separator/>
                <MenuItem Header="退出" Click="Exit_Click" Height="30" Padding="10,5"/>
            </MenuItem>
            <MenuItem Header="视图(_V)" Height="36" Padding="12,6">
                <MenuItem Header="刷新" Click="Refresh_Click" Height="30" Padding="10,5"/>
                <Separator/>
                <MenuItem Header="全屏" Click="FullScreen_Click" Height="30" Padding="10,5"/>
            </MenuItem>
            <MenuItem Header="工具(_T)" Height="36" Padding="12,6">
                <MenuItem Header="数据库优化..." Click="OptimizeDatabase_Click" Height="30" Padding="10,5"/>
                <MenuItem Header="数据库备份..." Click="BackupDatabase_Click" Height="30" Padding="10,5"/>
                <Separator/>
                <MenuItem Header="清理历史数据..." Click="CleanupData_Click" Height="30" Padding="10,5"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)" Height="36" Padding="12,6">
                <MenuItem Header="关于" Click="About_Click" Height="30" Padding="10,5"/>
            </MenuItem>
        </Menu>

        <!-- Tab控件 -->
        <TabControl Grid.Row="1" Margin="0" Padding="0">
            <!-- Tab 1: 实时监控 -->
            <TabItem Header="实时监控" FontSize="14" Height="40">
                <views:MonitorView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=MonitorViewModel}"/>
            </TabItem>

            <!-- Tab 2: 历史数据 -->
            <TabItem Header="历史数据" FontSize="14" Height="40">
                <views:HistoryView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=HistoryViewModel}"/>
            </TabItem>

            <!-- Tab 3: 报警管理 -->
            <TabItem Header="报警管理" FontSize="14" Height="40">
                <views:AlarmView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AlarmViewModel}"/>
            </TabItem>

            <!-- Tab 4: 设备配置 -->
            <TabItem Header="设备配置" FontSize="14" Height="40">
                <views:DeviceConfigView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DeviceConfigViewModel}"/>
            </TabItem>

            <!-- Tab 5: 系统设置 -->
            <TabItem Header="系统设置" FontSize="14" Height="40">
                <views:SettingsView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SettingsViewModel}"/>
            </TabItem>

            <!-- Tab 6: 单设备调试（旧版界面） -->
            <TabItem Header="单设备调试" FontSize="14" Height="40">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <TextBlock Grid.Row="0" Text="单设备调试模式（向下兼容）"
                              FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- 主内容区 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="500"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧控制面板 -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Top">
                            <views:SerialSettingsView DataContext="{Binding SerialSettingsViewModel}"/>
                            <views:ProtocolControlView DataContext="{Binding ProtocolControlViewModel}"/>
                        </StackPanel>

                        <!-- 右侧数据显示 -->
                        <views:DataDisplayView Grid.Column="1" DataContext="{Binding DataDisplayViewModel}"/>
                    </Grid>

                    <!-- 底部日志 -->
                    <views:LogView Grid.Row="2" DataContext="{Binding LogViewModel}"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
