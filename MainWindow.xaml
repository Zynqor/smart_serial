<Window x:Class="SerialProtocolAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SerialProtocolAssistant"
        xmlns:views="clr-namespace:SerialProtocolAssistant.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="RS-485多设备监控系统" Height="900" Width="1600"
        ResizeMode="CanResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 菜单栏 -->
        <Menu Grid.Row="0" Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
              MinHeight="40" FontSize="14" VerticalContentAlignment="Center">
            <MenuItem Header="文件(_F)" Padding="15,8">
                <MenuItem Header="加载协议配置..." Click="LoadProtocol_Click" Padding="12,6"/>
                <MenuItem Header="保存协议配置..." Click="SaveProtocol_Click" Padding="12,6"/>
                <Separator/>
                <MenuItem Header="导出当前数据..." Click="ExportCurrentData_Click" Padding="12,6"/>
                <Separator/>
                <MenuItem Header="系统设置..." Click="Settings_Click" Padding="12,6"/>
                <Separator/>
                <MenuItem Header="退出" Click="Exit_Click" Padding="12,6"/>
            </MenuItem>
            <MenuItem Header="视图(_V)" Padding="15,8">
                <MenuItem Header="刷新" Click="Refresh_Click" Padding="12,6"/>
                <Separator/>
                <MenuItem Header="全屏" Click="FullScreen_Click" Padding="12,6"/>
            </MenuItem>
            <MenuItem Header="工具(_T)" Padding="15,8">
                <MenuItem Header="数据库优化..." Click="OptimizeDatabase_Click" Padding="12,6"/>
                <MenuItem Header="数据库备份..." Click="BackupDatabase_Click" Padding="12,6"/>
                <Separator/>
                <MenuItem Header="清理历史数据..." Click="CleanupData_Click" Padding="12,6"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)" Padding="15,8">
                <MenuItem Header="关于" Click="About_Click" Padding="12,6"/>
            </MenuItem>
        </Menu>

        <!-- Tab控件 -->
        <TabControl Grid.Row="1" Margin="0" Padding="0">
            <!-- Tab 1: 实时监控 -->
            <TabItem Header="实时监控" FontSize="14" Height="40">
                <views:MonitorView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=MonitorViewModel}"/>
            </TabItem>

            <!-- Tab 2: 历史数据 -->
            <TabItem Header="历史数据" FontSize="14" Height="40">
                <views:HistoryView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=HistoryViewModel}"/>
            </TabItem>

            <!-- Tab 3: 报警管理 -->
            <TabItem Header="报警管理" FontSize="14" Height="40">
                <views:AlarmView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AlarmViewModel}"/>
            </TabItem>

            <!-- Tab 4: 日志 -->
            <TabItem Header="日志" FontSize="14" Height="40">
                <views:LogView DataContext="{Binding LogViewModel}"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
